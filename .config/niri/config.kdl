// DMS (DankMaterialShell) binds are included from dms/binds.kdl
include "dms/binds.kdl"
// Alt-tab overview styling for DMS
include "dms/alttab.kdl"

// ==========================================
// INPUT
// ==========================================

environment {
    QT_QPA_PLATFORMTHEME "xdgdesktopportal"
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
}

// ==========================================
// OUTPUTS (DUAL MONITOR)
// ==========================================

output "eDP-1" {
    scale 1
    transform "normal"
    position x=0 y=1080
}

output "HDMI-A-3" {
    scale 1
    transform "normal"
    position x=0 y=0
}


hotkey-overlay {
    // Avoid auto-showing the important hotkeys menu.
    skip-at-startup
}

// overview background
overview {
  backdrop-color "#0000"
}

// ==========================================
// LAYOUT (MINIMAL DEV MODE)
// ==========================================

layout {
    gaps 6
    center-focused-column "never"

    default-column-width { proportion 0.6; }

    focus-ring {
        width 2
        active-color "#c8bec3"
        inactive-color "#2a272b"
    }

    border {
        off
    }

    shadow {
        off
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
}

prefer-no-csd

animations {
    // slowdown 0.9
}

// ==========================================
// STARTUP PROGRAMS
// ==========================================

spawn-at-startup "dms" "run"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"

// ==========================================
// BINDS
// ==========================================
// Core keybinds live in dms/binds.kdl (notification center = Mod+N etc.).
// Personal app binds and DMS-conflict overrides only here:

binds {
    // --- TERMINAL / FILES (Spotlight = Mod+Space, also mapped to Mod+D) ---
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+E { spawn "dolphin"; }

    // --- POWER MENU (DMS UI, same as the bar icon) ---
    Mod+Shift+X { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // --- LOCK (override DMS shortcut-inhibit toggle) ---
    Mod+Escape allow-inhibiting=false { spawn "dms" "ipc" "call" "lock" "lock"; }

    // --- MONITOR FOCUS (old muscle memory; DMS uses Mod+Shift+arrows to move windows) ---
    Mod+Shift+Up   { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
}
