{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 34,

    "modules-left": [
        "custom/overview"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "memory",
        "network",
        "bluetooth",
        "wireplumber",
        "battery",
        "custom/power"
    ],

    "custom/overview": {
        "format": "󱗃",
        "tooltip": false,
        "on-click": "niri msg action toggle-overview"
    },

    "niri/workspaces": {
        "format": "{id}"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {}%",
        "max-length": 10
    },

    "tray": {
        "spacing": 6
    },

    "clock": {
        "tooltip-format": "{calendar}",
        "format": "{:%a, %d %b   %H:%M}"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "format-ethernet": "󰀂",
        "format-alt": "󱛇",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰀂  {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/rofi/wifi/wifi.sh &",
        "on-click-right": "~/.config/rofi/wifi/wifinew.sh &",
        "interval": 5
    },

    "bluetooth": {
        "format": "{icon}",
        "tooltip-format": "Bluetooth: {status}",
        "format-icons": {
            "enabled": "󰂯",
            "disabled": "󰂲",
            "connected": "󰂱"
        },
        "on-click": "blueman-manager"
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "tooltip-format": "Volume: {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 1",
        "on-scroll-down": "pamixer -d 1"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"],
            "default":  ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
        },
        "format-full": "󰁹 Full",
        "interval": 5,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "custom/power": {
        "format": "󰤆",
        "tooltip": false,
        "on-click": "~/.config/wofi/powermenu/powermenu.sh &"
    }
}

